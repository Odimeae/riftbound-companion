{
  "expo": {
    "name": "Riftbound Companion",
    "slug": "riftbound-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "riftbound-companion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.odimeae.riftboundcompanion"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.odimeae.riftboundcompanion"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "Riftbound Companion",
      "shortName": "Riftbound",
      "themeColor": "#090A0F",
      "backgroundColor": "#090A0F",
      "display": "standalone",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090A0F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/riftbound-companion"
    }
  }
}
